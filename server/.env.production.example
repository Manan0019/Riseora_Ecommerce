NODE_ENV=production
PORT=5000
CLIENT_URL=https://www.example.com
PUBLIC_SITE_URL=https://www.example.com
ALLOWED_ORIGINS=https://example.com
TRUST_PROXY=true
SERVE_CLIENT=true
DATABASE_URL=postgresql://APP_USER:STRONG_PASSWORD@DB_HOST:5432/riseora_ecommerce
JWT_SECRET=replace-with-64-plus-random-characters
JWT_EXPIRES_IN=7d
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=riseora/products
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Consent-based abandoned-cart recovery emails
CART_RECOVERY_ENABLED=false
CART_RECOVERY_FIRST_DELAY_MINUTES=120
CART_RECOVERY_SECOND_DELAY_MINUTES=1440

# Production backups
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=14
# Optional on Windows if PostgreSQL client tools are not on PATH.
# Example: C:\Program Files\PostgreSQL\18\bin
PG_BIN=
# Optional full executable overrides; normally leave blank when PG_BIN is set.
PG_DUMP_PATH=
PG_RESTORE_PATH=

# Phase 25 ERP synchronization
# Keep disabled until the ERP bridge/client is configured with the same secret.
ERP_SYNC_ENABLED=false
ERP_SYNC_API_KEY=
ERP_SYNC_MAX_BATCH=500


# Phase 41 observability / graceful shutdown
SLOW_REQUEST_MS=1000
SHUTDOWN_GRACE_MS=10000
RELEASE_NAME=
RELEASE_SHA=
