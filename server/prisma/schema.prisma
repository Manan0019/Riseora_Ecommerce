model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String?
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  adminRole    AdminRole?
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  failedLoginCount Int   @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  lastPasswordChangedAt DateTime?
  referralCode String @unique
  referredByUserId String? @db.Uuid
  referredBy User? @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals User[] @relation("UserReferrals")

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  productQuestions ProductQuestion[]
  checkoutSessions CheckoutSession[]
  returnRequests ReturnRequest[]
  cancellationRequests OrderCancellationRequest[]
  passwordResetTokens PasswordResetToken[]
  couponRedemptions CouponRedemption[]
  notifications Notification[]
  wishlistItems WishlistItem[]
  rewardAccount RewardAccount?
  rewardTransactions RewardTransaction[]
  rewardCoupons Coupon[] @relation("RewardCouponOwner")
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  supportTickets ContactMessage[]
  supportRecoveryGrants SupportRecoveryGrant[] @relation("SupportRecoveryCustomer")
  grantedSupportRecoveries SupportRecoveryGrant[] @relation("SupportRecoveryAdmin")
  retentionEnrollments RetentionEnrollment[] @relation("RetentionEnrollmentCustomer")
  createdRetentionCampaigns RetentionCampaign[] @relation("RetentionCampaignCreator")
  generatedDemandPlans DemandPlan[] @relation("DemandPlanGeneratedBy")
  approvedDemandPlans DemandPlan[] @relation("DemandPlanApprovedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  sentPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderSentBy")
  createdGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  postedGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptPostedBy")
  createdCycleCounts CycleCount[] @relation("CycleCountCreatedBy")
  approvedCycleCounts CycleCount[] @relation("CycleCountApprovedBy")
  postedCycleCounts CycleCount[] @relation("CycleCountPostedBy")
  createdInventoryRecalls InventoryRecall[] @relation("InventoryRecallCreatedBy")
  activatedInventoryRecalls InventoryRecall[] @relation("InventoryRecallActivatedBy")
  completedInventoryRecalls InventoryRecall[] @relation("InventoryRecallCompletedBy")
  inventoryBatchMovements InventoryBatchMovement[] @relation("InventoryBatchMovementActor")
  createdQualitySpecifications QualitySpecification[] @relation("QualitySpecificationCreatedBy")
  createdQualityInspections QualityInspection[] @relation("QualityInspectionCreatedBy")
  reviewedQualityInspections QualityInspection[] @relation("QualityInspectionReviewedBy")
  closedQualityIncidents SupplierQualityIncident[] @relation("SupplierQualityIncidentClosedBy")
  createdManufacturingBoms ManufacturingBom[] @relation("ManufacturingBomCreatedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreatedBy")
  approvedProductionOrders ProductionOrder[] @relation("ProductionOrderApprovedBy")
  startedProductionOrders ProductionOrder[] @relation("ProductionOrderStartedBy")
  completedProductionOrders ProductionOrder[] @relation("ProductionOrderCompletedBy")
  createdWorkCenters WorkCenter[] @relation("WorkCenterCreatedBy")
  createdProductionRoutings ProductionRouting[] @relation("ProductionRoutingCreatedBy")
  generatedMrpPlans MrpPlan[] @relation("MrpPlanGeneratedBy")
  approvedMrpPlans MrpPlan[] @relation("MrpPlanApprovedBy")
  createdProductionSchedules ProductionSchedule[] @relation("ProductionScheduleCreatedBy")
  publishedProductionSchedules ProductionSchedule[] @relation("ProductionSchedulePublishedBy")
  shopFloorDispatchedProductionOrders ProductionOrder[] @relation("ProductionOrderShopFloorDispatchedBy")
  startedProductionOperations ProductionOperationExecution[] @relation("ProductionOperationExecutionStartedBy")
  completedProductionOperations ProductionOperationExecution[] @relation("ProductionOperationExecutionCompletedBy")
  createdProductionDowntimeEvents ProductionDowntimeEvent[] @relation("ProductionDowntimeEventCreatedBy")
  productionLabourEntries ProductionLabourEntry[] @relation("ProductionLabourOperator")
  enteredProductionLabourEntries ProductionLabourEntry[] @relation("ProductionLabourEnteredBy")
  createdWorkCenterShifts WorkCenterShift[] @relation("WorkCenterShiftCreatedBy")
  refillReminders RefillReminder[]
  inventoryMovements InventoryMovement[] @relation("InventoryMovementActor")
  authSessions AuthSession[]
  authSecurityEvents AuthSecurityEvent[]
  marketingPreference MarketingPreference?
  consentEvents ConsentEvent[]
  privacyRequests PrivacyRequest[]
  accountCart AccountCart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive, createdAt])
  @@index([referredByUserId, createdAt])
}



model AccountCart {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Json
  revision Int @default(1)
  lastMergedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion Int
  deviceLabel String?
  userAgent String?
  ipHash String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedReason String?

  @@index([userId, revokedAt, lastSeenAt])
  @@index([expiresAt])
}

model AuthSecurityEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  type AuthSecurityEventType
  sessionId String? @db.Uuid
  identityHash String?
  deviceLabel String?
  userAgent String?
  ipHash String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([identityHash, createdAt])
}

model RewardAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int @default(0)
  lifetimeEarned Int @default(0)
  lifetimeRedeemed Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
}

model RewardTransaction {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type RewardTransactionType
  points Int
  balanceAfter Int
  description String
  sourceKey String? @unique
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @db.Uuid
  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  method     String
  path       String
  action     String
  statusCode Int
  durationMs Int?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  erpId       String? @unique
  erpManaged  Boolean @default(false)

  products Product[]
  couponLinks CouponCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InventoryMovementType {
  OPENING_STOCK
  ADMIN_ADJUSTMENT
  ORDER_RESERVATION
  ORDER_RELEASE
  ORDER_CANCELLATION
  RETURN_RESTOCK
  RETURN_REPLACEMENT
  REFUND_RESTOCK
  PURCHASE_RECEIPT
  WAREHOUSE_QUARANTINE
  WAREHOUSE_RELEASE
  WAREHOUSE_WRITE_OFF
  WAREHOUSE_COUNT_ADJUSTMENT
  QA_RELEASE
  QA_REJECT
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  MAINTENANCE_ISSUE
  ERP_SYNC
  CORRECTION
}

enum InventoryMovementSource {
  ADMIN
  CHECKOUT
  ORDER
  RETURN
  PURCHASE
  WAREHOUSE
  QUALITY
  MANUFACTURING
  MAINTENANCE
  ERP
  SYSTEM
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name             String
  slug             String  @unique
  shortDescription String?
  description      String?
  benefits         String?
  ingredients      String?
  howToUse         String?
  suitableFor      String?
  faq              Json?
  isActive         Boolean @default(true)
  isFeatured       Boolean @default(false)
  badge            String?
  maxPurchaseQuantity Int?
  codAllowed          Boolean @default(true)
  replenishmentEnabled Boolean @default(false)
  replenishmentDays    Int?
  replenishmentLabel   String?
  erpId               String? @unique
  erpManaged          Boolean @default(false)

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  questions ProductQuestion[]
  couponLinks CouponProduct[]
  wishlistItems WishlistItem[]
  campaignLinks CampaignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name              String
  sku               String   @unique
  size              String?
  unit              String?
  mrp               Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  safetyStock        Int      @default(0)
  weightGrams       Decimal? @db.Decimal(10, 2)
  hsnCode           String?
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  inventoryRole     InventoryRole @default(FINISHED_GOOD)
  erpId             String?  @unique
  erpManaged        Boolean  @default(false)

  orderItems OrderItem[]
  stockAlerts StockAlert[]
  priceAlerts PriceAlert[]
  refillReminders RefillReminder[]
  inventoryMovements InventoryMovement[]
  demandPlanItems DemandPlanItem[]
  supplierOffers SupplierVariant[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  inventoryBatches InventoryBatch[]
  inventoryBatchMovements InventoryBatchMovement[]
  orderBatchAllocations OrderBatchAllocation[]
  cycleCountItems CycleCountItem[]
  qualitySpecification QualitySpecification?
  qualityInspections QualityInspection[]
  manufacturingBomOutputs ManufacturingBom[] @relation("ManufacturingBomOutput")
  manufacturingBomComponents ManufacturingBomItem[] @relation("ManufacturingBomComponent")
  productionOutputs ProductionOrder[] @relation("ProductionOutputVariant")
  productionMaterialLines ProductionOrderMaterial[] @relation("ProductionMaterialVariant")
  productionRoutings ProductionRouting[] @relation("ProductionRoutingOutput")
  mrpPlanItems MrpPlanItem[]
  maintenanceSpareUsages MaintenanceSpareUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@index([safetyStock])
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type InventoryMovementType
  source InventoryMovementSource
  quantityChange Int
  stockBefore Int
  stockAfter Int
  safetyStockSnapshot Int @default(0)
  reason String?
  referenceType String?
  referenceId String?
  actorUserId String? @db.Uuid
  actorUser User? @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique
  checkoutRequestKey String? @unique
  dispatchDueAt DateTime?

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String

  shippingAddress Json
  shippingZoneName String?
  deliveryEstimate Json?

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  couponCode    String?
  automaticPromotionName String?
