generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AdminRole {
  OWNER
  OPERATIONS
  CATALOG
  MARKETING
  SUPPORT
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDING
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ORDER
  PRODUCT
  CATEGORY
}

enum CouponApplication {
  ORDER_TOTAL
  ELIGIBLE_ITEMS
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
}

enum CheckoutSessionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_PENDING
  IN_TRANSIT
  RECEIVED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum CancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  WITHDRAWN
}

enum ShipmentEventType {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RTO_INITIATED
  RTO_DELIVERED
  NOTE
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  BANK_TRANSFER
  UPI
  STORE_CREDIT
  OTHER
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum CartRecoveryStatus {
  ACTIVE
  CONVERTED
  DISMISSED
  EXPIRED
}

enum StockAlertStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

enum PriceAlertStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

enum NotificationType {
  GENERAL
  ORDER
  PRICE_DROP
  STOCK_ALERT
  CAMPAIGN
}

enum RewardTransactionType {
  ORDER_EARN
  REVIEW_BONUS
  REFERRAL_BONUS
  REFERRAL_WELCOME
  VOUCHER_REDEEM
  REVERSAL
  ADMIN_ADJUST
}

enum MerchandisingDealType {
  BUNDLE_DISCOUNT
  BUY_X_GET_Y
  GIFT_WITH_PURCHASE
}

enum ErpSyncDirection {
  ERP_TO_ECOMMERCE
  ECOMMERCE_TO_ERP
}

enum ErpSyncKind {
  CATALOG
  ORDERS
}

enum ErpSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}


model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String?
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  adminRole    AdminRole?
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  referralCode String @unique
  referredByUserId String? @db.Uuid
  referredBy User? @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals User[] @relation("UserReferrals")

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  productQuestions ProductQuestion[]
  checkoutSessions CheckoutSession[]
  returnRequests ReturnRequest[]
  cancellationRequests OrderCancellationRequest[]
  passwordResetTokens PasswordResetToken[]
  couponRedemptions CouponRedemption[]
  notifications Notification[]
  wishlistItems WishlistItem[]
  rewardAccount RewardAccount?
  rewardTransactions RewardTransaction[]
  rewardCoupons Coupon[] @relation("RewardCouponOwner")
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive, createdAt])
  @@index([referredByUserId, createdAt])
}

model RewardAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int @default(0)
  lifetimeEarned Int @default(0)
  lifetimeRedeemed Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balance])
}

model RewardTransaction {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type RewardTransactionType
  points Int
  balanceAfter Int
  description String
  sourceKey String? @unique
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @db.Uuid
  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  method     String
  path       String
  action     String
  statusCode Int
  durationMs Int?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  erpId       String? @unique
  erpManaged  Boolean @default(false)

  products Product[]
  couponLinks CouponCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name             String
  slug             String  @unique
  shortDescription String?
  description      String?
  benefits         String?
  ingredients      String?
  howToUse         String?
  suitableFor      String?
  faq              Json?
  isActive         Boolean @default(true)
  isFeatured       Boolean @default(false)
  badge            String?
  maxPurchaseQuantity Int?
  codAllowed          Boolean @default(true)
  erpId               String? @unique
  erpManaged          Boolean @default(false)

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  questions ProductQuestion[]
  couponLinks CouponProduct[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name              String
  sku               String   @unique
  size              String?
  unit              String?
  mrp               Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  weightGrams       Decimal? @db.Decimal(10, 2)
  hsnCode           String?
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  erpId             String?  @unique
  erpManaged        Boolean  @default(false)

  orderItems OrderItem[]
  stockAlerts StockAlert[]
  priceAlerts PriceAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique
  checkoutRequestKey String? @unique

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String

  shippingAddress Json
  shippingZoneName String?
  deliveryEstimate Json?

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  couponCode    String?
  automaticPromotionName String?
  automaticDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  shipment      Shipment?
  checkoutSession CheckoutSession?
  invoice       Invoice?
  returnRequests ReturnRequest[]
  cancellationRequest OrderCancellationRequest?
  couponRedemption CouponRedemption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status, createdAt])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  note   String?
  source String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Shipment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  estimatedDeliveryAt DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  events ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShipmentEvent {
  id String @id @default(uuid()) @db.Uuid

  shipmentId String @db.Uuid
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  type ShipmentEventType
  title String
  note String?
  location String?
  customerVisible Boolean @default(true)
  eventAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([shipmentId, eventAt])
  @@index([type, eventAt])
}

model OrderCancellationRequest {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status CancellationRequestStatus @default(REQUESTED)
  reason String
  customerNote String?
  adminNote String?

  requestedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  variantName String?
  sku         String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  hsnCode   String?
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  promotionLabel String?
  isComplimentary Boolean @default(false)

  returnItems ReturnRequestItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  transactionId     String? @unique

  amount Decimal @db.Decimal(12, 2)
  paidAt DateTime?
  refundId String? @unique
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}


model CheckoutSession {
  id String @id @default(uuid()) @db.Uuid

  checkoutRequestKey String? @unique

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String
  shippingAddress Json
  shippingZoneName String?
  deliveryEstimate Json?
  couponCode String?
  automaticPromotionName String?
  automaticDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  amountPaise    Int
  currency       String @default("INR")
  items          Json

  status            CheckoutSessionStatus @default(PENDING)
  providerOrderId   String? @unique
  providerPaymentId String? @unique
  stockReserved     Boolean @default(false)
  paymentAttemptCount Int @default(0)
  lastPaymentStatus String?
  lastPaymentError String?
  lastPaymentActivityAt DateTime?

  orderId String? @unique @db.Uuid
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([userId])
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  eventId String @unique
  eventType String
  providerOrderId String?
  providerPaymentId String?
  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([providerOrderId])
}

model StoreSetting {
  id String @id @default("primary")

  storeName     String @default("Riseora Herbals")
  legalName     String?
  supportEmail  String?
  supportPhone  String?
  gstin         String?

  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String @default("India")

  invoicePrefix    String @default("RISE")
  invoiceNextNumber Int  @default(1)

  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  flatShippingFee       Decimal  @default(0) @db.Decimal(12, 2)
  codFee                Decimal  @default(0) @db.Decimal(12, 2)
  codEnabled            Boolean  @default(true)
  codMinOrderAmount     Decimal? @db.Decimal(12, 2)
  codMaxOrderAmount     Decimal? @db.Decimal(12, 2)
  maxOpenCodOrdersPerCustomer Int?
  dispatchWithinDays    Int      @default(2)
  deliveryMinDays       Int      @default(3)
  deliveryMaxDays       Int      @default(7)
  lowStockUrgencyThreshold Int   @default(5)
  requireServiceablePostalCode Boolean @default(false)

  returnsEnabled   Boolean @default(true)
  returnWindowDays Int     @default(7)
  returnPolicy     String?
  shippingPolicy   String?
  privacyPolicy    String?
  termsPolicy      String?

  brandTagline          String?
  logoUrl               String?
  logoMarkUrl           String?
  logoAlt               String?
  announcementText      String?
  announcementSecondary String?
  siteUrl               String?
  seoTitle              String?
  seoDescription        String?
  aboutTitle            String?
  aboutBody             String?
  contactIntro          String?
  instagramUrl          String?
  facebookUrl           String?
  youtubeUrl            String?
  whatsappNumber        String?

  rewardsEnabled Boolean @default(true)
  rewardPointsPerHundred Int @default(5)
  rewardVoucherPoints Int @default(500)
  rewardVoucherAmount Decimal @default(50) @db.Decimal(12, 2)
  rewardVoucherMinOrderAmount Decimal @default(499) @db.Decimal(12, 2)
  rewardVoucherValidityDays Int @default(90)
  rewardReviewBonusPoints Int @default(25)
  rewardReferralReferrerPoints Int @default(100)
  rewardReferralNewCustomerPoints Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  type     NotificationType @default(GENERAL)
  ctaLabel String?
  ctaUrl   String?
  metadata Json?
  dedupeKey String? @unique

  isRead Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}


model WishlistItem {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model WishlistShare {
  id String @id @default(uuid()) @db.Uuid
  token String @unique
  title String?
  productIds Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ShippingZone {
  id String @id @default(uuid()) @db.Uuid

  name           String
  postalPrefixes Json
  city           String?
  state          String?

  shippingFee          Decimal? @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  codAllowed           Boolean  @default(true)
  deliveryMinDays      Int?
  deliveryMaxDays      Int?

  isActive Boolean @default(true)
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

model ShippingPartner {
  id String @id @default(uuid()) @db.Uuid

  name                String @unique
  code                String @unique
  trackingUrlTemplate String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  invoiceNumber String @unique
  issuedAt      DateTime @default(now())

  sellerName    String
  sellerGstin   String?
  sellerAddress Json
  buyerName     String
  buyerAddress  Json

  taxableTotal Decimal @default(0) @db.Decimal(12, 2)
  cgstTotal    Decimal @default(0) @db.Decimal(12, 2)
  sgstTotal    Decimal @default(0) @db.Decimal(12, 2)
  igstTotal    Decimal @default(0) @db.Decimal(12, 2)
  taxTotal     Decimal @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal @db.Decimal(12, 2)
  lines        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnRequest {
  id String @id @default(uuid()) @db.Uuid

  returnNumber String @unique
  orderId      String @db.Uuid
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status       ReturnStatus @default(REQUESTED)
  reason       String
  details      String?
  customerNote String?
  adminNote    String?

  refundMethod     RefundMethod?
  refundAmount     Decimal @default(0) @db.Decimal(12, 2)
  providerRefundId String?
  refundReference  String?

  reverseCarrier        String?
  reverseTrackingNumber String?
  reverseTrackingUrl    String?

  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  restockedAt DateTime?
  refundedAt  DateTime?

  items ReturnRequestItem[]
  evidence ReturnEvidence[]
  statusHistory ReturnStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status, requestedAt])
}

model ReturnRequestItem {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity         Int
  unitRefundAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnEvidence {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  url String
  publicId String?
  originalName String?
  createdAt DateTime @default(now())

  @@index([returnRequestId, createdAt])
}

model ReturnStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  status ReturnStatus
  note String?
  source String?
  customerVisible Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([returnRequestId, createdAt])
}

model Coupon {
  id String @id @default(uuid()) @db.Uuid

  code          String             @unique
  description   String?
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  scope         CouponScope        @default(ORDER)
  application   CouponApplication  @default(ORDER_TOTAL)

  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  usageLimit             Int?
  usageCount             Int @default(0)
  perCustomerUsageLimit  Int? @default(1)
  rewardOwnerUserId String? @db.Uuid
  rewardOwner User? @relation("RewardCouponOwner", fields: [rewardOwnerUserId], references: [id], onDelete: Cascade)
  rewardPointsCost Int?

  products     CouponProduct[]
  categories   CouponCategory[]
  redemptions  CouponRedemption[]

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@index([rewardOwnerUserId, isActive])
}

model CouponProduct {
  couponId  String @db.Uuid
  productId String @db.Uuid
  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String @db.Uuid
  categoryId String @db.Uuid
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model CouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail String?
  customerPhone String?
  redeemedAt DateTime @default(now())

  @@index([couponId, userId])
  @@index([couponId, customerEmail])
  @@index([couponId, customerPhone])
}

