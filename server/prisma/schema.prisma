  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([status, nextReminderAt])
  @@index([userId, status, nextReminderAt])
  @@index([variantId, status])
}

model SystemJobState {
  key String @id

  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastDurationMs  Int?
  lastSummary     Json?
  lastError       String?

  leaseOwner String?
  leaseUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseUntil])
  @@index([lastFailedAt])
}

model ErpSyncState {
  id String @id @default("primary")

  lastCatalogSyncAt       DateTime?
  lastCatalogSyncId       String?
  lastOrderPullAt         DateTime?
  lastOrderAckAt          DateTime?
  lastAcknowledgedCursor  String?
  lastClientId            String?
  lastError               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErpSyncLog {
  id String @id @default(uuid()) @db.Uuid

  direction ErpSyncDirection
  kind      ErpSyncKind
  status    ErpSyncStatus
  syncId    String? @unique
  clientId  String?

  receivedCount Int @default(0)
  createdCount  Int @default(0)
  updatedCount  Int @default(0)
  skippedCount  Int @default(0)
  failedCount   Int @default(0)
  message       String?

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([status, createdAt])
}


// Phase 98: versioned, reviewed customer-facing visual storefront. DRAFT never serves publicly.
model StorefrontExperience {
  id String @id @default("primary")
  draft Json
  published Json?
  revision Int @default(1)
  publishedRevision Int @default(0)
  updatedByUserId String? @db.Uuid
  publishedByUserId String? @db.Uuid
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorefrontExperiencePublication {
  id String @id @default(uuid()) @db.Uuid
  revision Int @unique
  snapshot Json
  actorUserId String? @db.Uuid
  action String @default("PUBLISHED")
  publishedAt DateTime @default(now())
  @@index([publishedAt])
}
