generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDING
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
}

enum CheckoutSessionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_PENDING
  IN_TRANSIT
  RECEIVED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL_PAYMENT
  BANK_TRANSFER
  UPI
  STORE_CREDIT
  OTHER
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum CartRecoveryStatus {
  ACTIVE
  CONVERTED
  DISMISSED
  EXPIRED
}

enum StockAlertStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

enum MerchandisingDealType {
  BUNDLE_DISCOUNT
  BUY_X_GET_Y
  GIFT_WITH_PURCHASE
}


model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String?
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  checkoutSessions CheckoutSession[]
  returnRequests ReturnRequest[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  type       AddressType @default(HOME)
  isDefault  Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name             String
  slug             String  @unique
  shortDescription String?
  description      String?
  benefits         String?
  ingredients      String?
  howToUse         String?
  suitableFor      String?
  faq              Json?
  isActive         Boolean @default(true)
  isFeatured       Boolean @default(false)
  badge            String?

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name              String
  sku               String   @unique
  size              String?
  unit              String?
  mrp               Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  weightGrams       Decimal? @db.Decimal(10, 2)
  hsnCode           String?
  gstRate           Decimal  @default(0) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)

  orderItems OrderItem[]
  stockAlerts StockAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String

  shippingAddress Json

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  couponCode    String?
  automaticPromotionName String?
  automaticDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  shipment      Shipment?
  checkoutSession CheckoutSession?
  invoice       Invoice?
  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  note   String?
  source String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Shipment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  variantName String?
  sku         String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  hsnCode   String?
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  promotionLabel String?
  isComplimentary Boolean @default(false)

  returnItems ReturnRequestItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  transactionId     String? @unique

  amount Decimal @db.Decimal(12, 2)
  paidAt DateTime?
  refundId String? @unique
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}


model CheckoutSession {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String
  shippingAddress Json
  couponCode String?
  automaticPromotionName String?
  automaticDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  amountPaise    Int
  currency       String @default("INR")
  items          Json

  status            CheckoutSessionStatus @default(PENDING)
  providerOrderId   String? @unique
  providerPaymentId String? @unique
  stockReserved     Boolean @default(false)

  orderId String? @unique @db.Uuid
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([userId])
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  eventId String @unique
  eventType String
  providerOrderId String?
  providerPaymentId String?
  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([providerOrderId])
}

model StoreSetting {
  id String @id @default("primary")

  storeName     String @default("Riseora Herbals")
  legalName     String?
  supportEmail  String?
  supportPhone  String?
  gstin         String?

  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String @default("India")

  invoicePrefix    String @default("RISE")
  invoiceNextNumber Int  @default(1)

  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  flatShippingFee       Decimal  @default(0) @db.Decimal(12, 2)
  codFee                Decimal  @default(0) @db.Decimal(12, 2)

  returnsEnabled   Boolean @default(true)
  returnWindowDays Int     @default(7)
  returnPolicy     String?
  shippingPolicy   String?
  privacyPolicy    String?
  termsPolicy      String?

  brandTagline          String?
  logoUrl               String?
  logoMarkUrl           String?
  logoAlt               String?
  announcementText      String?
  announcementSecondary String?
  siteUrl               String?
  seoTitle              String?
  seoDescription        String?
  aboutTitle            String?
  aboutBody             String?
  contactIntro          String?
  instagramUrl          String?
  facebookUrl           String?
  youtubeUrl            String?
  whatsappNumber        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingPartner {
  id String @id @default(uuid()) @db.Uuid

  name                String @unique
  code                String @unique
  trackingUrlTemplate String?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  invoiceNumber String @unique
  issuedAt      DateTime @default(now())

  sellerName    String
  sellerGstin   String?
  sellerAddress Json
  buyerName     String
  buyerAddress  Json

  taxableTotal Decimal @default(0) @db.Decimal(12, 2)
  cgstTotal    Decimal @default(0) @db.Decimal(12, 2)
  sgstTotal    Decimal @default(0) @db.Decimal(12, 2)
  igstTotal    Decimal @default(0) @db.Decimal(12, 2)
  taxTotal     Decimal @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal @db.Decimal(12, 2)
  lines        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnRequest {
  id String @id @default(uuid()) @db.Uuid

  returnNumber String @unique
  orderId      String @db.Uuid
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status       ReturnStatus @default(REQUESTED)
  reason       String
  details      String?
  customerNote String?
  adminNote    String?

  refundMethod     RefundMethod?
  refundAmount     Decimal @default(0) @db.Decimal(12, 2)
  providerRefundId String?
  refundReference  String?

  reverseCarrier        String?
  reverseTrackingNumber String?
  reverseTrackingUrl    String?

  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  restockedAt DateTime?
  refundedAt  DateTime?

  items ReturnRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status, requestedAt])
}

model ReturnRequestItem {
  id String @id @default(uuid()) @db.Uuid

  returnRequestId String @db.Uuid
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity         Int
  unitRefundAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model Coupon {
  id String @id @default(uuid()) @db.Uuid

  code          String             @unique
  description   String?
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)

  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  usageLimit Int?
  usageCount Int @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
}

model Offer {
  id String @id @default(uuid()) @db.Uuid

  title       String
  description String?
  badge       String?
  ctaText     String?
  ctaLink     String?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean @default(true)
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@index([startsAt, endsAt])
}


model MerchandisingDeal {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String @unique
  type        MerchandisingDealType
  description String?
  badge       String?
  imageUrl    String?

  discountPercent Decimal? @db.Decimal(5, 2)
  bundleItems Json?

  buyVariantId  String? @db.Uuid
  giftVariantId String? @db.Uuid
  buyQuantity   Int @default(1)
  giftQuantity  Int @default(1)
  minOrderAmount Decimal? @db.Decimal(12, 2)

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  priority   Int @default(0)
  startsAt   DateTime?
  endsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@index([startsAt, endsAt])
}


model Review {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating           Int
  title            String?
  comment          String
  isApproved       Boolean @default(false)
  verifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, isApproved])
}

model Banner {
  id String @id @default(uuid()) @db.Uuid

  placement      BannerPlacement @default(HOME_HERO)
  eyebrow        String?
  title          String
  description    String?
  imageUrl       String?
  mobileImageUrl String?
  ctaText        String?
  ctaLink        String?
  background     String?
  textColor      String?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean @default(true)
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, priority])
  @@index([startsAt, endsAt])
}


model CartRecoverySession {
  id String @id @default(uuid()) @db.Uuid

  cartToken String @unique @default(uuid())
  userId String? @db.Uuid
  email  String
  name   String?
  phone  String?
  items  Json
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  recoveryOptIn Boolean @default(false)
  reminderCount Int @default(0)
  lastReminderAt DateTime?
  status CartRecoveryStatus @default(ACTIVE)
  orderNumber String?
  lastSeenAt DateTime @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, lastSeenAt])
  @@index([email])
  @@index([userId])
}

model ContactMessage {
  id String @id @default(uuid()) @db.Uuid

  name    String
  email   String
  phone   String?
  subject String?
  message String

  status    ContactMessageStatus @default(NEW)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id String @id @default(uuid()) @db.Uuid

  email String @unique
  name  String?
  source String?
  isActive Boolean @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, subscribedAt])
}


model StockAlert {
  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  email String
  name  String?
  status StockAlertStatus @default(PENDING)
  subscribedAt DateTime @default(now())
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, email])
  @@index([status, createdAt])
  @@index([email])
}
