NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=
TRUST_PROXY=false
SERVE_CLIENT=false
DATABASE_URL=postgresql://riseora_app:YOUR_PASSWORD@127.0.0.1:5432/riseora_ecommerce_dev
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=riseora/products
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Consent-based abandoned-cart recovery emails
CART_RECOVERY_ENABLED=false
CART_RECOVERY_FIRST_DELAY_MINUTES=120
CART_RECOVERY_SECOND_DELAY_MINUTES=1440

# Phase 25 ERP synchronization
# Keep disabled until the ERP bridge/client is configured with the same secret.
ERP_SYNC_ENABLED=false
ERP_SYNC_API_KEY=
ERP_SYNC_MAX_BATCH=500

