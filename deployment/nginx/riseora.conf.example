# Example reverse proxy. Replace domain, upstream port and certificate paths for your host.
server {
  listen 80;
  server_name example.invalid www.example.invalid;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl http2;
  server_name example.invalid www.example.invalid;
  ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  client_max_body_size 20m;
  location / {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 60s;
  }
}
