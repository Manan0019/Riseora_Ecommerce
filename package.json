{
  "name": "riseora-ecommerce",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n API,WEB \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "db:generate": "npm run prisma:generate --workspace server",
    "db:migrate": "npm run prisma:migrate --workspace server",
    "db:deploy": "npm run prisma:deploy --workspace server",
    "db:seed": "npm run prisma:seed --workspace server",
    "db:studio": "npm run prisma:studio --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
